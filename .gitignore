node_modules/
dist/
.vite/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# WinDivert (driver da saída do Discord): a pasta existe para o glob de recursos
# do Tauri resolver; os binários vêm de scripts/fetch-windivert.* e ficam fora
# do git (docs/discord-tunnel.md T-11).
src-tauri/resources/*
!src-tauri/resources/.gitkeep
!src-tauri/resources/windivert/
src-tauri/resources/windivert/*
!src-tauri/resources/windivert/.gitkeep

# Ícones: os derivados saem de `npm run icons`. A arte de origem
# (src-tauri/icons/source/) é versionada — é dela que tudo é gerado.
src-tauri/icons/*.png
src-tauri/icons/*.ico

# Config local do cargo (linker deste ambiente)
src-tauri/.cargo/

# Artefatos de release montados pela CI
dist-release/
