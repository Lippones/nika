node_modules/
dist/
.vite/

# Rust / Tauri
src-tauri/target/
src-tauri/gen/

# Tor Expert Bundle: baixado por scripts/fetch-tor.ps1, nunca versionado
# (ver docs/tor-bundle.md).
src-tauri/resources/*
!src-tauri/resources/.gitkeep
# O diretório do shim do Discord existe sempre (para o glob de recursos do Tauri
# resolver mesmo sem o shim compilado); o version.dll em si é gerado e não vai.
!src-tauri/resources/discord/
!src-tauri/resources/discord/.gitkeep
src-tauri/resources/discord/version.dll

# target do shim (crate fora do workspace)
src-tauri/discord-shim/target/

# Ícones: os derivados saem de `npm run icons`. A arte de origem
# (src-tauri/icons/source/) é versionada — é dela que tudo é gerado.
src-tauri/icons/*.png
src-tauri/icons/*.ico

# Config local do cargo (linker deste ambiente)
src-tauri/.cargo/

# Artefatos de release montados pela CI
dist-release/
